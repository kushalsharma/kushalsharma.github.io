---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOCIAL } from "../consts";

const TIMELINE = [
  {
    when: "2024 — now",
    what: "Muse Mesh",
    detail:
      "Founded it. Built an OpenAI-compatible LLM gateway with credits, quotas, rate limiting and billing; a consumer app on iOS, Android and web running on top of it; and open-source agent frameworks underneath. Solo, end to end — architecture, code, deploys, marketing, taxes.",
  },
  {
    when: "2022 — 2023",
    what: "Virgio",
    detail:
      "Zero to one on the commerce platform — client architecture, React Native, first release in about four months, 100k DAU within a year. Built the widget framework that let product change the app's UI without a release, cutting UI turnaround from days to minutes.",
  },
  {
    when: "2016 — 2022",
    what: "Flipkart",
    detail:
      "Android and iOS at scale. Took the Android APK from 50 MB to 10 MB and the Gradle build from 45 minutes to 15. Rewrote the iOS multi-widget framework behind the homepage to render at 60 FPS. Wrote Lyrics end to end — Flipkart's open-source schema-to-code generator, which emits Java and Swift types from one schema — and contributed to proteus, their JSON layout engine.",
  },
  {
    when: "2014 — 2018",
    what: "Alphawolf",
    detail:
      "Self-taught Android, nights and weekends. Two apps on the Play Store and 500,000+ downloads — Wallmax averaged 4.3 out of 5 across 10,000+ reviews. The first time I did the whole loop myself: idea, prototype, feedback, launch, iterate.",
  },
  {
    when: "Always",
    what: "Hardware",
    detail:
      "Microcontrollers, sensors, things that move. It was a hobby I never had time for while working full time. Now it's what weekends are for.",
  },
];
---

<BaseLayout
  title="About"
  description="Kushal Sharma — founder of Muse Mesh, building LLM gateway and agent infrastructure. Previously ten years shipping Android at Flipkart and Bengaluru startups."
>
  <section class="mx-auto max-w-5xl px-5 pb-10 pt-16 sm:px-8 sm:pt-24">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">About</h1>

    <div class="mt-8 max-w-2xl space-y-5 text-[17px] leading-relaxed">
      <p>
        I'm Kushal. I build AI infrastructure — the parts that sit under the demo and decide whether
        it survives contact with real users.
      </p>
      <p class="text-muted">
        That mostly means gateways, permissions, quotas and audit trails. Not the most exciting thing
        to talk about at a party, but it's the difference between an AI feature that ships and one
        that quietly bankrupts you when a single customer writes a loop.
      </p>
      <p class="text-muted">
        Before this I spent ten years as an IC engineer in Bengaluru, most of it building Android at
        scale. I started Muse Mesh because I wanted to build the whole thing rather than one layer
        of it.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-16 sm:px-8">
    <h2 data-reveal class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Timeline</h2>

    <div class="mt-8 space-y-8">
      {
        TIMELINE.map((t) => (
          <div data-reveal class="grid gap-2 border-l-2 pl-5 sm:grid-cols-[10rem_1fr] sm:gap-6" style="border-color: var(--color-accent);">
            <p class="font-mono text-xs text-muted">{t.when}</p>
            <div>
              <h3 class="font-semibold">{t.what}</h3>
              <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-muted">{t.detail}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-20 sm:px-8">
    <h2 data-reveal class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Elsewhere</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        SOCIAL.map((s) => (
          <li data-reveal>
            <a
              href={s.href}
              target="_blank"
              rel="me noreferrer"
              class="group flex items-center justify-between rounded-xl border px-4 py-3 text-sm transition-colors hover:surface"
            >
              <span class="font-medium">{s.name}</span>
              <span class="font-mono text-xs text-muted transition-transform duration-300 group-hover:translate-x-0.5">
                {s.handle} →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
