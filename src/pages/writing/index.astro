---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPublishedPosts } from "../../lib/posts";

const posts = await getPublishedPosts();

const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

const byYear = posts.reduce<Record<string, typeof posts>>((acc, p) => {
  const y = String(p.data.pubDate.getFullYear());
  (acc[y] ??= []).push(p);
  return acc;
}, {});
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout
  title="Writing"
  description="Posts on AI infrastructure, agents, LLM gateways, machine learning and the occasional Raspberry Pi that gets out of hand."
>
  <section class="mx-auto max-w-5xl px-5 pb-8 pt-16 sm:px-8 sm:pt-24">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Writing</h1>
    <p class="mt-4 max-w-xl text-muted">
      Mostly things I built and what broke. {posts.length} posts since 2017.
    </p>

    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter posts by tag">
      <button
        type="button"
        data-tag="all"
        class="tag-btn rounded-lg border px-3 py-1.5 font-mono text-xs transition-colors"
        aria-pressed="true"
      >
        all
      </button>
      {
        tags.map((t) => (
          <button
            type="button"
            data-tag={t}
            class="tag-btn rounded-lg border px-3 py-1.5 font-mono text-xs text-muted transition-colors"
            aria-pressed="false"
          >
            {t}
          </button>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-16 sm:px-8">
    {
      years.map((year) => (
        <div class="year-group" data-year={year}>
          <h2 class="sticky top-14 z-10 -mx-2 mt-10 px-2 py-3 font-mono text-xs uppercase tracking-[0.2em] text-muted backdrop-blur-xl" style="background-color: color-mix(in oklch, var(--bg) 82%, transparent);">
            {year}
          </h2>
          {byYear[year].map((p) => (
            <div class="post-item" data-tags={p.data.tags.join(" ")}>
              <PostCard
                href={`/writing/${p.id}/`}
                title={p.data.title}
                description={p.data.description}
                pubDate={p.data.pubDate}
                tags={p.data.tags}
                featured={p.data.featured}
              />
            </div>
          ))}
        </div>
      ))
    }

    <p data-no-results hidden class="py-16 text-center text-sm text-muted">
      No posts with that tag yet.
    </p>
  </section>
</BaseLayout>

<style>
  .tag-btn[aria-pressed="true"] {
    background: color-mix(in oklch, var(--color-accent) 16%, transparent);
    color: var(--color-accent);
    border-color: color-mix(in oklch, var(--color-accent) 40%, transparent);
  }
</style>

<script is:inline>
  (() => {
    const buttons = document.querySelectorAll(".tag-btn");
    const items = document.querySelectorAll(".post-item");
    const groups = document.querySelectorAll(".year-group");
    const none = document.querySelector("[data-no-results]");

    buttons.forEach((btn) =>
      btn.addEventListener("click", () => {
        const tag = btn.dataset.tag;
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));

        let shown = 0;
        items.forEach((item) => {
          const match = tag === "all" || item.dataset.tags.split(" ").includes(tag);
          item.hidden = !match;
          if (match) shown++;
        });

        // Hide a year heading when everything under it is filtered out.
        groups.forEach((g) => {
          const any = [...g.querySelectorAll(".post-item")].some((i) => !i.hidden);
          g.hidden = !any;
        });

        none.hidden = shown > 0;
      }),
    );
  })();
</script>
