---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PROJECTS } from "../consts";
---

<BaseLayout
  title="Projects"
  description="LLM gateway infrastructure, self-hosted agent frameworks, MCP servers, a consumer AI app, and ESP32 hardware. What Kushal Sharma has built and shipped."
>
  <section class="mx-auto max-w-5xl px-5 pb-10 pt-16 sm:px-8 sm:pt-24">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Projects</h1>
    <p class="mt-4 max-w-xl text-muted">
      Infrastructure, agents, and one thing that only exists because I like soldering.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-16 sm:px-8">
    <div class="grid gap-4 sm:grid-cols-2">
      {
        PROJECTS.map((p) => (
          <a
            data-reveal
            href={p.href}
            target={p.href.startsWith("http") ? "_blank" : undefined}
            rel={p.href.startsWith("http") ? "noreferrer" : undefined}
            class="group relative overflow-hidden rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-1 hover:surface"
          >
            <div
              class="pointer-events-none absolute -right-16 -top-16 h-40 w-40 rounded-full opacity-0 blur-3xl transition-opacity duration-500 group-hover:opacity-60"
              style="background: radial-gradient(closest-side, var(--color-accent), transparent);"
              aria-hidden="true"
            />

            <p class="font-mono text-[11px] uppercase tracking-wider text-muted">{p.meta}</p>

            <h2 class="mt-3 text-xl font-semibold tracking-tight transition-colors group-hover:text-[var(--color-accent)]">
              {p.name}
            </h2>

            <p class="mt-1 text-sm font-medium">{p.tagline}</p>

            <p class="mt-3 text-sm leading-relaxed text-muted">{p.body}</p>

            <span class="mt-5 inline-flex items-center gap-1 font-mono text-xs text-muted transition-transform duration-300 group-hover:translate-x-1">
              open →
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
