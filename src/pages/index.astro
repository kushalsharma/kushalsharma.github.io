---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPublishedPosts } from "../lib/posts";
import { PROJECTS, SOCIAL } from "../consts";

const posts = (await getPublishedPosts()).slice(0, 4);

const NOW = [
  { label: "Building", value: "An LLM gateway that meters and bills, not just routes" },
  { label: "Open source", value: "mu and phoebe — self-hosted agents with a paper trail" },
  { label: "Weekends", value: "ESP32 nodes that a voice agent can actually move" },
  { label: "Open to", value: "B2B work — agent layers for products that need one" },
];
---

<BaseLayout>
  {/* ── Hero ───────────────────────────────────────────────── */}
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute -top-40 left-1/2 h-[420px] w-[820px] -translate-x-1/2 opacity-40 blur-[110px]"
      style="background: radial-gradient(closest-side, var(--color-accent), transparent 70%);"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -top-24 right-0 h-[320px] w-[520px] opacity-30 blur-[110px]"
      style="background: radial-gradient(closest-side, var(--color-accent-2), transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-5xl px-5 pb-20 pt-20 sm:px-8 sm:pt-28">
      <p class="font-mono text-xs tracking-wider text-muted">
        <span class="caret">kushal@bengaluru:~$</span>
      </p>

      <h1 class="mt-6 max-w-3xl text-4xl font-semibold leading-[1.08] tracking-tight sm:text-6xl">
        I build the <span class="gradient-text">infrastructure</span> that AI products sit on.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
        Founder of <a href="https://mume.ai" class="link-underline text-[var(--fg)]">Muse Mesh</a>. I
        build LLM gateways, agent frameworks and the unglamorous parts underneath — permissions,
        quotas, audit trails, billing. Ten years shipping Android at Flipkart and Bengaluru startups
        before this.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="/writing/"
          class="rounded-xl px-5 py-2.5 text-sm font-medium text-white transition-transform duration-300 hover:-translate-y-0.5"
          style="background: linear-gradient(110deg, var(--color-accent), var(--color-accent-2));"
        >
          Read the writing
        </a>
        <a
          href="/projects/"
          class="rounded-xl border px-5 py-2.5 text-sm font-medium transition-colors hover:surface"
        >
          See what I've built
        </a>
      </div>

      <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-muted">
        {
          SOCIAL.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="me noreferrer" class="link-underline hover:text-[var(--fg)]">
                {s.handle}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Now ────────────────────────────────────────────────── */}
  <section class="border-t">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8">
      <h2 data-reveal class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Right now</h2>
      <dl class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2">
        {
          NOW.map((n) => (
            <div data-reveal class="border-l-2 pl-4" style="border-color: var(--color-accent);">
              <dt class="font-mono text-[11px] uppercase tracking-wider text-muted">{n.label}</dt>
              <dd class="mt-1 text-[15px] leading-relaxed">{n.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* ── Writing ────────────────────────────────────────────── */}
  <section class="border-t">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8">
      <div data-reveal class="flex items-baseline justify-between gap-4">
        <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Writing</h2>
        <a href="/writing/" class="link-underline text-sm text-muted hover:text-[var(--fg)]">
          All posts →
        </a>
      </div>

      <div class="mt-4">
        {
          posts.map((p) => (
            <PostCard
              href={`/writing/${p.id}/`}
              title={p.data.title}
              description={p.data.description}
              pubDate={p.data.pubDate}
              tags={p.data.tags}
              featured={p.data.featured}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Projects ───────────────────────────────────────────── */}
  <section class="border-t">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8">
      <div data-reveal class="flex items-baseline justify-between gap-4">
        <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Selected work</h2>
        <a href="/projects/" class="link-underline text-sm text-muted hover:text-[var(--fg)]">
          Everything →
        </a>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          PROJECTS.slice(0, 3).map((p) => (
            <a
              data-reveal
              href={p.href}
              class="group rounded-2xl border p-5 transition-all duration-300 hover:-translate-y-1 hover:surface"
            >
              <p class="font-mono text-[11px] uppercase tracking-wider text-muted">{p.meta}</p>
              <h3 class="mt-2 font-semibold transition-colors group-hover:text-[var(--color-accent)]">
                {p.name}
              </h3>
              <p class="mt-1 text-sm text-muted">{p.tagline}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Contact ────────────────────────────────────────────── */}
  <section class="border-t">
    <div class="mx-auto max-w-5xl px-5 py-20 sm:px-8">
      <div data-reveal class="max-w-2xl">
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
          Building a product that needs an agent layer?
        </h2>
        <p class="mt-4 text-muted">
          I've built one for a YC-backed fintech and I run the infrastructure underneath my own
          consumer app. If you're about to hire a team to do this, it's worth a conversation first —
          I'll tell you honestly whether you should just do it in-house.
        </p>
        <a
          href="https://www.linkedin.com/in/kushalsharma"
          target="_blank"
          rel="noreferrer"
          class="mt-7 inline-block rounded-xl border px-5 py-2.5 text-sm font-medium transition-colors hover:surface"
        >
          Get in touch →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
