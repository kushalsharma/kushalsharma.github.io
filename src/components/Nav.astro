---
import { NAV, SITE } from "../consts";
const path = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b backdrop-blur-xl"
  style="background-color: color-mix(in oklch, var(--bg) 78%, transparent);"
>
  <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-5 sm:px-8">
    <a
      href="/"
      class="group flex items-center gap-2.5 text-sm font-semibold tracking-tight"
      aria-label={`${SITE.title} — home`}
    >
      <span
        class="inline-block h-2 w-2 rounded-full transition-transform duration-500 group-hover:scale-150"
        style="background: linear-gradient(120deg, var(--color-accent), var(--color-accent-2));"
      ></span>
      {SITE.title}
    </a>

    <div class="flex items-center gap-1">
      {
        NAV.map((item) => {
          const active = path === item.href || path.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                "rounded-lg px-3 py-1.5 text-sm transition-colors",
                active ? "font-medium" : "text-muted hover:text-[var(--fg)]",
              ]}
              aria-current={active ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }

      <button
        type="button"
        data-palette-open
        class="ml-1 hidden items-center gap-1.5 rounded-lg border px-2.5 py-1.5 text-xs text-muted transition-colors hover:text-[var(--fg)] sm:flex"
        aria-label="Open command palette"
      >
        <span>Search</span>
        <kbd class="font-mono text-[10px] opacity-70">⌘K</kbd>
      </button>

      <button
        type="button"
        data-theme-toggle
        class="ml-1 rounded-lg border p-1.5 text-muted transition-colors hover:text-[var(--fg)]"
        aria-label="Toggle colour theme"
      >
        <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>
